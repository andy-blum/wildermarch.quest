---
layout: base.njk
---
<h1>{{ name }}</h1>

<aside class="infobox">
  <div class="infobox-header">{{ name }}</div>
  {% if image %}
  <div class="infobox-image">
    <img src="/images/creatures/{{ image }}" alt="{{ name }}">
  </div>
  {% endif %}
  <table>
    <tr><th>Type</th><td>{{ type }}</td></tr>
    <tr><th>Threat</th><td>{{ threat }}</td></tr>
  </table>
</aside>

{{ content | safe }}

{% set creatureSessions = collections.sessions | mentionedIn("creatures", page.fileSlug) %}
{% if creatureSessions.length %}
<section>
  <h2>Encountered In</h2>
  <ul>
    {% for session in creatureSessions %}
    <li><a href="{{ session.url }}">{{ session.data.title }}</a></li>
    {% endfor %}
  </ul>
</section>
{% endif %}
