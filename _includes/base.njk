<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title or name }} | West of Wonder</title>
  <link rel="stylesheet" href="/css/style.css">
  <script type="module" src="/js/search.js"></script>
</head>
<body>
  <div class="site-wrapper">
    <nav class="site-nav">
      <a href="/">Home</a>
      <div class="nav-dropdown">
        <button class="nav-dropdown-toggle">Story</button>
        <div class="nav-dropdown-menu">
          <a href="/characters/">Characters</a>
          <a href="/sessions/">Sessions</a>
        </div>
      </div>
      <div class="nav-dropdown">
        <button class="nav-dropdown-toggle">World</button>
        <div class="nav-dropdown-menu">
          <a href="/locations/">Locations</a>
          <a href="/npcs/">NPCs</a>
          <a href="/factions/">Factions</a>
          <a href="/creatures/">Creatures</a>
        </div>
      </div>
      <div class="nav-dropdown">
        <button class="nav-dropdown-toggle">Lore</button>
        <div class="nav-dropdown-menu">
          <a href="/storylines/">Storylines</a>
          <a href="/rumors/">Rumors</a>
          <a href="/items/">Items</a>
          <a href="/documents/">Documents</a>
        </div>
      </div>
      <a href="/map/">Map</a>
      <a href="/artwork/">Artwork</a>
      <form id="search-form" role="search" hidden>
        <input
          type="search"
          name="query"
          id="search-input"
          placeholder="Search..."
          autocomplete="off"
        />
        <button type="submit" disabled>Search</button>
      </form>
    </nav>
    <dialog id="search-results" aria-labelledby="search-results-heading">
      <header class="search-results-header">
        <h2 id="search-results-heading">Search Results</h2>
        <button class="search-close" aria-label="Close search results">&times;</button>
      </header>
      <select class="search-filter-select" id="search-filters" aria-label="Filter by type">
        <option value="">All types</option>
      </select>
      <ul id="search-results-list" aria-live="polite"></ul>
    </dialog>
    <main>
      {{ content | safe }}
    </main>
  </div>
</body>
</html>
