---
layout: base.njk
---
<article>
  <header>
    <h1>{{ title }}</h1>
    <p class="meta">
      {{ type }}
      {% if author %}
        {% set docAuthor = collections.characters | find(author) %}
        {% if not docAuthor %}
          {% set docAuthor = collections.npcs | find(author) %}
        {% endif %}
        {% if docAuthor %}
          by <a href="{{ docAuthor.url }}">{{ docAuthor.data.name }}</a>
        {% endif %}
      {% endif %}
      | {{ date | dateDisplay }}
    </p>
  </header>

  <div class="document-content">
    {{ content | safe }}
  </div>
</article>

{% if session %}
{% set relatedSession = collections.sessions | find(session) %}
{% if relatedSession %}
<section>
  <h2>Related Session</h2>
  <ul>
    <li><a href="{{ relatedSession.url }}">{{ relatedSession.data.title }}</a></li>
  </ul>
</section>
{% endif %}
{% endif %}
