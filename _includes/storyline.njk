---
layout: base.njk
---
<h1>{{ name }}</h1>

<aside class="infobox">
  <div class="infobox-header">{{ name }}</div>
  <table>
    <tr><th>Status</th><td><span class="tag">{{ status }}</span></td></tr>
  </table>
  {% set storylineFactions = collections.factions | findAll(factions) %}
  {% if storylineFactions.length %}
  <div class="infobox-section">Factions</div>
  <ul>
    {% for faction in storylineFactions %}
    <li><a href="{{ faction.url }}">{{ faction.data.name }}</a></li>
    {% endfor %}
  </ul>
  {% endif %}
  {% set storylineLocs = collections.locations | findAll(locations) %}
  {% if storylineLocs.length %}
  <div class="infobox-section">Locations</div>
  <ul>
    {% for loc in storylineLocs %}
    <li><a href="{{ loc.url }}">{{ loc.data.name }}</a></li>
    {% endfor %}
  </ul>
  {% endif %}
</aside>

{{ content | safe }}

{% set storylineLocs2 = collections.locations | findAll(locations) %}
{% set mapSlugs = [] %}
{% for loc in storylineLocs2 %}
  {% if loc.data.mapX and loc.data.mapY %}
    {% set mapSlugs = (mapSlugs.push(loc.fileSlug), mapSlugs) %}
  {% endif %}
{% endfor %}
{% if mapSlugs.length %}
<section>
  <h2>Map</h2>
  <div class="map-container">
    <img src="/images/wildermarch-map-small.webp" alt="Map of locations in this storyline" width="852" height="639">
    {% for loc in storylineLocs2 %}
      {% if loc.data.mapX and loc.data.mapY %}
        <span class="map-pin highlighted" style="left: {{ loc.data.mapX }}%; top: {{ loc.data.mapY }}%;" title="{{ loc.data.name }}">
          <span class="map-pin-label">{{ loc.data.name }}</span>
        </span>
      {% endif %}
    {% endfor %}
  </div>
</section>
{% endif %}

{% set storylineSessions = collections.sessions | mentionedIn("storylines", page.fileSlug) %}
{% if storylineSessions.length %}
<section>
  <h2>Sessions</h2>
  <ul>
    {% for session in storylineSessions %}
    <li><a href="{{ session.url }}">{{ session.data.title }}</a> ({{ session.data.date | dateDisplay }})</li>
    {% endfor %}
  </ul>
</section>
{% endif %}
