---
layout: base.njk
---
<h1>{{ name }}</h1>

<aside class="infobox">
  <div class="infobox-header">{{ name }}</div>
  {% if image %}
  <div class="infobox-image">
    <img src="/images/npcs/{{ image }}" alt="{{ name }}">
  </div>
  {% endif %}
  <table>
    <tr><th>Disposition</th><td>{{ disposition }}</td></tr>
    <tr><th>Status</th><td>{% if alive %}Alive{% else %}Deceased{% endif %}</td></tr>
    {% if location %}
    {% set npcLoc = collections.locations | find(location) %}
    {% if npcLoc %}
    <tr><th>Location</th><td><a href="{{ npcLoc.url }}">{{ npcLoc.data.name }}</a></td></tr>
    {% endif %}
    {% endif %}
    {% if faction %}
    {% set npcFaction = collections.factions | find(faction) %}
    {% if npcFaction %}
    <tr><th>Faction</th><td><a href="{{ npcFaction.url }}">{{ npcFaction.data.name }}</a></td></tr>
    {% endif %}
    {% endif %}
  </table>
</aside>

{{ content | safe }}

{% set npcSessions = collections.sessions | mentionedIn("npcs", page.fileSlug) %}
{% if npcSessions.length %}
<section>
  <h2>Sessions</h2>
  <ul>
    {% for session in npcSessions %}
    <li><a href="{{ session.url }}">{{ session.data.title }}</a></li>
    {% endfor %}
  </ul>
</section>
{% endif %}

{% set npcRumors = collections.rumors | mentionedIn("npcs", page.fileSlug) %}
{% if npcRumors.length %}
<section>
  <h2>Rumors</h2>
  <ul>
    {% for rumor in npcRumors %}
    <li><a href="{{ rumor.url }}">{{ rumor.data.title }}</a></li>
    {% endfor %}
  </ul>
</section>
{% endif %}
