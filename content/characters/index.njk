---
layout: base.njk
title: Characters
permalink: /characters/
---
<h1>Characters</h1>

<h2>Active</h2>
<table>
  <thead>
    <tr>
      <th></th>
      <th>Name</th>
      <th>Race</th>
      <th>Class</th>
    </tr>
  </thead>
  <tbody>
    {% for char in collections.characters | sortBy('name') %}
    {% if char.data.status == 'active' %}
    <tr>
      <td class="table-thumb">{% if char.data.portrait %}<img src="/images/characters/{{ char.data.portrait }}" alt="">{% endif %}</td>
      <td><a href="{{ char.url }}">{{ char.data.name }}</a></td>
      <td>{{ char.data.race }}</td>
      <td>{{ char.data.class }}{% if char.data.subclass %} ({{ char.data.subclass }}){% endif %}</td>
    </tr>
    {% endif %}
    {% endfor %}
  </tbody>
</table>

<h2>Retired & Fallen</h2>
<table>
  <thead>
    <tr>
      <th></th>
      <th>Name</th>
      <th>Race</th>
      <th>Class</th>
      <th>Status</th>
    </tr>
  </thead>
  <tbody>
    {% for char in collections.characters | sortBy('name') %}
    {% if char.data.status == 'retired' or char.data.status == 'dead' %}
    <tr>
      <td class="table-thumb">{% if char.data.portrait %}<img src="/images/characters/{{ char.data.portrait }}" alt="">{% endif %}</td>
      <td><a href="{{ char.url }}">{{ char.data.name }}</a></td>
      <td>{{ char.data.race }}</td>
      <td>{{ char.data.class }}{% if char.data.subclass %} ({{ char.data.subclass }}){% endif %}</td>
      <td><span class="status status--{{ char.data.status }}">{{ char.data.status }}</span></td>
    </tr>
    {% endif %}
    {% endfor %}
  </tbody>
</table>
